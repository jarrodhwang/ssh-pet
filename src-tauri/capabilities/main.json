{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window may call its typed Rust dispatcher.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-main-command",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
